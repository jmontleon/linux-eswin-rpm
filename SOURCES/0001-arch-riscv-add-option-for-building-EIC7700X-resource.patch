From 3e84ca56b6646abb97c549c2ae824449631715a6 Mon Sep 17 00:00:00 2001
From: Min Lin <linmin@eswincomputing.com>
Date: Mon, 6 Jan 2025 11:17:34 +0000
Subject: [PATCH 01/74] arch: riscv: add option for building EIC7700X resources

Create a config option to build EIC7700X SoC specific resources

Signed-off-by: Min Lin <linmin@eswincomputing.com>
Signed-off-by: Darshan Prajapati <darshan.prajapati@einfochips.com>
Signed-off-by: Pinkesh Vaghela <pinkesh.vaghela@einfochips.com>
---
 arch/riscv/Kconfig.socs | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/riscv/Kconfig.socs b/arch/riscv/Kconfig.socs
index 848e7149e443..3741afdd8244 100644
--- a/arch/riscv/Kconfig.socs
+++ b/arch/riscv/Kconfig.socs
@@ -98,4 +98,9 @@ config SOC_CANAAN_K210
 	help
 	  This enables support for Canaan Kendryte K210 SoC platform hardware.
 
+config SOC_SIFIVE_EIC7700
+	bool "ESWIN EIC7700x SoCs"
+	help
+	  This enables support for ESWIN EIC7700X SoC platform hardware.
+
 endmenu # "SoC selection"
-- 
2.52.0

