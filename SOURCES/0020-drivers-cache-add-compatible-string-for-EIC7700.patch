From 5b714b4e74c33ab6aff32c0d69e1cd36495dc41a Mon Sep 17 00:00:00 2001
From: Pritesh Patel <pritesh.patel@einfochips.com>
Date: Tue, 7 Jan 2025 06:16:58 +0000
Subject: [PATCH 20/69] drivers: cache: add compatible string for EIC7700

add "sifive,eic7700" compatible string in sifive ccache ids

Signed-off-by: Pritesh Patel <pritesh.patel@einfochips.com>
---
 drivers/cache/sifive_ccache.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/cache/sifive_ccache.c b/drivers/cache/sifive_ccache.c
index e1a283805ea7..c32510e10458 100644
--- a/drivers/cache/sifive_ccache.c
+++ b/drivers/cache/sifive_ccache.c
@@ -125,6 +125,8 @@ static const struct of_device_id sifive_ccache_ids[] = {
 	{ .compatible = "starfive,jh7100-ccache",
 	  .data = (void *)(QUIRK_NONSTANDARD_CACHE_OPS | QUIRK_BROKEN_DATA_UNCORR) },
 	{ .compatible = "sifive,ccache0" },
+	{ .compatible = "sifive,eic7700",
+	  .data = (void *)(QUIRK_NONSTANDARD_CACHE_OPS) },
 	{ /* end of table */ }
 };
 
